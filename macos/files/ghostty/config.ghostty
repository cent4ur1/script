# Window
window-padding-x = 0
window-padding-y = 0
macos-titlebar-style = hidden
background-opacity = 0.6
background-blur-radius = 0
quit-after-last-window-closed = true
 
# Scrollback
scrollback-limit = 100000
 
# Font
font-family = Hack Nerd Font
font-size = 18
 
# Colors
background = #000000
foreground = #ffffff
 
# Cursor
cursor-color = #008b94
cursor-text = #fafafa
 
# Palette (normal colors)
palette = 0=#333f4a
palette = 1=#d95468
palette = 2=#8bd49c
palette = 3=#ebbf83
palette = 4=#539afc
palette = 5=#b62d65
palette = 6=#70e1e8
palette = 7=#b7c5d3
 
# Hyperlinks (Ghostty handles URLs natively — no extra config needed)
 
# Note: the following alacritty settings have no direct ghostty equivalent:
#   - hints.enabled (regex URL matching / custom commands) — ghostty opens URLs natively
#   - window.decorations = "Buttonless" is approximated with macos-titlebar-style = hidden
#   - blur = false (set background-blur-radius = 0 above; increase for blur)
 

