{
    "layer": "top",
    "position": "top",
    "height": 29,
    "spacing": 0,
    "margin": 0,
    "exclusive": true,

    "modules-left": [
        "custom/chevron",
        "hyprland/window"
    ],

    "modules-right": [
        "battery",
        "tray",
        "pulseaudio",
        "clock"
    ],

    "custom/chevron": {
        "format": "",
        "tooltip": false
    },

    "hyprland/window": {
        "format": "{}",
        "separate-outputs": true,
        "rewrite": {
            "": ""
        }
    },

    "clock": {
        "interval": 10,
        "format": "{:%H:%M %a %d %b %Y}",
        "tooltip-format": "{:%Y-%m-%d}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5,
        "tooltip": false
    },

    "tray": {
        "spacing": 8,
        "icon-size": 18
    },

    "battery": {
        "interval": 120,
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "states": {
            "warning": 20,
            "critical": 10
        },
        "tooltip": false
    }
}
